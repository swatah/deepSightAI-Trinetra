FROM python:3.11-slim

WORKDIR /workspace

# Set environment for tests - use SQLite file to avoid connection errors
ENV DATABASE_URL=sqlite:///test.db

# Copy requirements and install dependencies
COPY deepSightAI/Trinetra/AuthService/requirements.txt /workspace/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt pytest

# Copy package configuration, deepSightAI package hierarchy, config, and tests
COPY setup.py pyproject.toml /workspace/
COPY deepSightAI /workspace/deepSightAI
COPY config /workspace/config
COPY tests /workspace/tests

# Install deepSightAI package natively
RUN pip install --no-deps -e .


CMD ["pytest", "tests/auth/", "tests/middleware/", "-v"]
