FROM python:3.11-slim

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    curl \
    bash \
    ca-certificates \
    gnupg \
    lsb-release \
    apt-transport-https \
    && rm -rf /var/lib/apt/lists/*

# Install Docker CLI (for communicating with host Docker daemon via mounted socket)
RUN curl -fsSL https://get.docker.com -o get-docker.sh && \
    sh get-docker.sh && \
    rm get-docker.sh

# Install kubectl from Debian repositories (reliable)
RUN apt-get update && apt-get install -y kubectl && \
    rm -rf /var/lib/apt/lists/*

# Install Helm via official script
RUN curl -fsSL https://raw.githubusercontent.com/helm/helm/main/scripts/get-helm-3 | bash

# Set working directory
WORKDIR /workspace

# Copy requirements from canonical paths first (cache layer)
COPY deepSightAI/Trinetra/Embedder/requirements_embedder.txt /workspace/requirements_embedder.txt
COPY deepSightAI/Trinetra/ServerAndExtractor/requirements.txt /workspace/requirements.txt
COPY deepSightAI/Trinetra/UI/requirements_ui.txt /workspace/requirements_ui.txt
COPY deepSightAI/Trinetra/AuthService/requirements.txt /workspace/requirements_auth.txt
RUN pip install --no-cache-dir -r requirements.txt -r requirements_embedder.txt -r requirements_ui.txt -r requirements_auth.txt \
    && pip install --no-cache-dir pytest pytest-cov pytest-xdist pyyaml

# Copy source code
COPY . .

# Install deepSightAI package natively
RUN pip install --no-deps -e .


# Default command - can be overridden
CMD ["pytest", "tests/unit/", "-v"]
