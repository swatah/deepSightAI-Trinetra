# ==============================================================================
# deepSightAI-Trinetra - Environment Configuration Template (.env.example)
# Copy this file to .env.local or .env for local development / testing.
# In production, sensitive secrets should be managed via HashiCorp Vault.
# ==============================================================================

# ------------------------------------------------------------------------------
# PostgreSQL (Relational Storage: Cameras, Plates, Watchlists, Alerts, Audits)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trinetra
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=trinetra
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# Redis (Stream Processing, Event Bus, Dead-Letter Queues, Caching)
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# MinIO / S3 (Object Storage for Extracted Video Frames & Crops)
# ------------------------------------------------------------------------------
MINIO_ENDPOINT=localhost:9000
MINIO_URL=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=trinetra-frames
MINIO_SECURE=false

# AWS S3 compatibility
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1

# ------------------------------------------------------------------------------
# Milvus (Vector Database for Re-ID & Visual Embeddings)
# ------------------------------------------------------------------------------
MILVUS_HOST=localhost
MILVUS_PORT=19530

# ------------------------------------------------------------------------------
# Authentication, RBAC & JWT Security
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=change-this-to-a-secure-random-key-in-production
JWT_ALGORITHM=RS256
JWT_PUBLIC_KEY_PATH=/etc/trinetra/secrets/jwt_public.pem
JWT_PRIVATE_KEY_PATH=/etc/trinetra/secrets/jwt_private.pem
OAUTH_TOKEN_PATH=/etc/trinetra/secrets/oauth_token.json
LOGIN_CREDENTIALS_PATH=/etc/trinetra/secrets/login.json

# ------------------------------------------------------------------------------
# License Plate Recognition (LPR) & Vision AI
# ------------------------------------------------------------------------------
LPR_BACKEND=mock
LPR_CONFIDENCE_THRESHOLD=0.75
LPR_MODEL_PATH=/opt/models/lpr

# ------------------------------------------------------------------------------
# Microservice Ports
# ------------------------------------------------------------------------------
MAIN_API_PORT=8000
EXTRACTOR_PORT=8001
SEARCH_API_PORT=8002
VPS_PORT=8003
WATCHLIST_PORT=8004
AUTH_PORT=8005
AUDIT_PORT=8006
UI_PORT=8501

# ------------------------------------------------------------------------------
# Reliability, Resilience & Observability
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO
METRICS_ENABLED=true
MAX_RETRY_ATTEMPTS=3
DLQ_STREAM=trinetra:stream:dlq
IDLE_RECLAIM_TIMEOUT_MS=60000
